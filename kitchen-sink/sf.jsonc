{
  "$schema": "https://spacefast.com/schemas/sf.json",
  "name": "Field Notes",
  "fallback": "/index.html",
  "cleanUrls": true,
  "listing": false,
  "meta": {
    "title": "Field Notes",
    "description": "A small blog with a large Spacefast runtime behind it.",
    "image": "/api/og.png",
  },
  "access": "public",
  "superpowers": { "enabled": true },
  "theme": {
    "name": "Field Notes",
    "accent": "#b6462d",
    "background": "#f7f4ec",
    "font": "system-ui, sans-serif",
  },
  "runtime": {
    "kind": "zero",
    "server": "server/index.ts",
    "client": "client/index.tsx",
  },
  "redirects": [
    { "source": "/latest", "destination": "/posts/the-useful-edge", "status": 302 },
    { "source": "/feed", "destination": "/api/feed.xml", "status": 301 },
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" },
      ],
    },
  ],
}
