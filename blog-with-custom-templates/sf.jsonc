{
  "$schema": "https://spacefast.com/schemas/sf.json",
  "name": "The Margins",
  "cleanUrls": true,
  "listing": false,
  "access": "public",
  "meta": {
    "title": "The Margins",
    "description": "Essays about the small decisions that shape useful software."
  },
  "theme": {
    "name": "The Margins",
    "accent": "#e25d33",
    "background": "#f1ede3",
    "font": "system-ui, sans-serif",
    "radius": "0px"
  },
  "redirects": [
    { "source": "/latest", "destination": "/posts/the-useful-edge.html", "status": 302 }
  ],
  "headers": [
    {
      "source": "/*",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
