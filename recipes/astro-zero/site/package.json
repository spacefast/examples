{
  "name": "astro-zero",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && node scripts/stage-capsule.mjs && sf build dist",
    "stage": "node scripts/stage-capsule.mjs",
    "runtime": "sf dev --dir dist",
    "publish": "sf publish dist --wait"
  },
  "dependencies": {
    "@astrojs/preact": "^6.0.4",
    "@spacefast/astro": "0.4.1",
    "@spacefast/zero": "0.4.1",
    "astro": "^7.2.9",
    "preact": "^10.29.8"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
